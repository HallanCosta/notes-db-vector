# ==============================================
# Configuração de Banco de Dados
# ==============================================
# PostgreSQL + pgvector local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/notes

# ==============================================
# Configuração opcional do Supabase (mantida para o modo Supabase)
# ==============================================
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================
# Configuração de Embeddings
# ==============================================
# O modo local usa Ollama; os outros providers continuam disponíveis para testes.
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=2560

# ==============================================
# OLLAMA
# ==============================================
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# ==============================================
# MINIMAX
# ==============================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
