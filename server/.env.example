# ==============================================
# Configuração de Banco de Dados
# ==============================================
# Exemplo local; substitua pelos valores do seu ambiente.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/notes

# ==============================================
# Configuração do Supabase (para APIs)
# ==============================================
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================
# Configuração de Embeddings
# ==============================================
# Escolha o provider: openai, minimax, huggingface, ou ollama
EMBEDDING_PROVIDER=ollama

# ==============================================
# OLLAMA
# ==============================================
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# ==============================================
# GOOGLE GEMINI
# ==============================================
GOOGLE_API_KEY=your_google_api_key_here

# ==============================================
# MINIMAX
# ==============================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# ==============================================
# GROQ
# ==============================================
# Quando GROQ_API_KEY estiver configurada e CHAT_PROVIDER não for definido,
# o backend seleciona o Groq automaticamente e usa qwen/qwen3.8-27b.
GROQ_API_KEY=your_groq_api_key_here
